amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

jobs = 2
fail_fast = false

hooks {
  ["pre-commit"] {
    steps {
      ["generated-workflows"] {
        check = "preview=$(mktemp -d) && trap 'find \"$preview\" -depth -delete' EXIT && mise exec -- velnor-actions generate --output-dir \"$preview\" && diff -r .github \"$preview/.github\""
      }
    }
  }
  ["pre-push"] {
    steps {
      ["generated-workflows"] {
        check = "preview=$(mktemp -d) && trap 'find \"$preview\" -depth -delete' EXIT && mise exec -- velnor-actions generate --output-dir \"$preview\" && diff -r .github \"$preview/.github\""
      }
    }
  }
}
